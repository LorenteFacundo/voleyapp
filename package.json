{
  "name": "aplicacion-de-voleibol",
  "version": "1.0.0",
  "description": "Aplicacion para reservar canchas y organizar partidos de voleibol.",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "prebuild": "node scripts/validate-env.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "validate:env": "node scripts/validate-env.mjs",
    "test": "vitest run",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint . && tsc -b --pretty false",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "typecheck": "tsc -b --pretty false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.16.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.14",
    "vitest": "^5.0.3"
  }
}
