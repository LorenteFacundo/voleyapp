# Copiá este archivo como .env.local y completá los valores del proyecto.
# Para desarrollar sin tocar Supabase usá `npm run dev:local` (no necesita este archivo).

# Proyecto de Supabase (URL HTTPS y clave publicable/anon; nunca la service_role).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Opcional: monitoreo de errores con Sentry.
VITE_SENTRY_DSN=

# Formulario "Sumá tu cancha" de la landing. Activar después de desplegar la
# Edge Function submit-club-lead y su secreto CLUB_LEAD_RATE_LIMIT_SALT.
VITE_CLUB_LEADS_ENABLED=false

# WhatsApp de contacto en la landing: dígitos internacionales, sin + ni espacios.
VITE_CONTACT_WHATSAPP=

# La pausa de reservas y la lista de acceso del piloto se manejan desde
# Administración → Operación (en el servidor), no con variables de entorno.
