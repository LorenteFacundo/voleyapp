{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.herramientas.tsbuildinfo"
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
